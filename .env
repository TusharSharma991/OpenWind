# Docker Compose variable defaults — committed, upstream-safe.
# Override any of these in .env.server (gitignored) for hosted deployments.

# Host ports for services exposed to the host — isolated range so this fork
# can run side by side with the upstream OSS OpenWind stack on the same host.
ADMIN_UI_HOST_PORT=10406
POSTGRES_HOST_PORT=10408

APP_URL=

# AuthNexus (external OIDC provider) — RS256 JWT verification via JWKS only, no local
# identity-provider container and no introspection call.
# Override in .env.local for hosted deployments if the authority ever changes.
AUTHNEXUS_ISSUER=https://auth.rokkalabs.com
AUTHNEXUS_JWKS_URL=https://auth.rokkalabs.com/api/v1/auth/jwks
AUTHNEXUS_AUDIENCE=382580183942627331
AUTHNEXUS_PROJECT_ID=382580151663198211
