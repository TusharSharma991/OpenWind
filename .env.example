NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# Connect via PgBouncer (port 10409), not Postgres directly (port 10408).
# PgBouncer uses transaction mode, which is required for SET LOCAL RLS scoping.
# Fixed UUID for the dev tenant — all authenticated users are scoped to this tenant in development.
# Matches the tenant inserted by db:seed. Do not change unless you wipe and re-seed.
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001

DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:10409/platform
# Migrations must run as the superuser (CREATE SCHEMA requires it).
# Points directly to Postgres (port 10408), bypassing PgBouncer.
MIGRATION_DATABASE_URL=postgresql://migration_user:migration_user_dev_password@localhost:10408/platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ──────────────────────────────────────────────────────────────────────
# Host port 10407 (not the default 6379) — this stack runs alongside the OSS
# Zitadel stack's ow-cache, which already claims 6379 on the host.
REDIS_URL=redis://localhost:10407

# APP_URL: the URL the frontend (admin-ui) is served from.
# Drives CORS_ORIGIN on the backend and API_URL in the browser bundle.
#   Local dev:   http://localhost:10406
#   Production:  https://openwind-nexus.rokkalabs.com
APP_URL=http://localhost:10406

# ── Auth (AuthNexus) ────────────────────────────────────────────────────────────
# External OIDC provider — RS256 JWT verification via JWKS only, no local
# identity-provider container and no introspection call.
AUTHNEXUS_ISSUER=https://auth.rokkalabs.com
AUTHNEXUS_JWKS_URL=https://auth.rokkalabs.com/api/v1/auth/jwks
AUTHNEXUS_AUDIENCE=your_authnexus_web_client_id

# Frontend (browser) OIDC client config — consumed by apps/admin-ui/vite.config.ts
# and injected into window.__CONFIG__ via /env.js.
AUTHNEXUS_AUTHORITY=https://auth.rokkalabs.com
AUTHNEXUS_CLIENT_ID=your_authnexus_web_client_id
AUTHNEXUS_ORG_ID=your_authnexus_org_id
AUTHNEXUS_PROJECT_ID=your_authnexus_project_id

# ── Notifications (Novu) ───────────────────────────────────────────────────────
NOVU_API_KEY=your_novu_api_key_here

# ── File storage (MinIO / S3) ──────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:10410
S3_BUCKET=platform-files
S3_ACCESS_KEY=platform_access_key
S3_SECRET_KEY=platform_secret_key_dev_only

# ── Docker Compose overrides (optional) ───────────────────────────────────────
# Override host-port mappings when the defaults conflict with other services.
# These are consumed by docker-compose.yml via ${VAR:-default} syntax.
# Leave unset for standard local dev (uses the default ports shown).
#
# POSTGRES_HOST_PORT=10408    # host port for direct Postgres access (default: 10408)
# ADMIN_UI_HOST_PORT=10406    # host port for Vite dev server (default: 10406)
#
# ── Vite dev server (server deployments only) ──────────────────────────────────
# VITE_ALLOWED_HOSTS=openwind.yourcompany.com  # comma-separated; omit for local dev
# VITE_API_PROXY_TARGET=http://ow-backend:3000 # proxy /api to this URL; omit for local dev

# ── AI (Anthropic) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Secrets (OpenBao) ──────────────────────────────────────────────────────────
# OpenBao UI: http://localhost:8200
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TRANSIT_KEY=platform-credentials

# Dev: use the static root token (set by docker-compose openbao service).
OPENBAO_TOKEN=dev-root-token

# Production (AppRole): comment out OPENBAO_TOKEN and set these instead.
# OPENBAO_ROLE_ID=
# OPENBAO_SECRET_ID=
