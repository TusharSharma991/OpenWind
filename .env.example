NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# Connect via PgBouncer (port 10409), not Postgres directly (port 10408).
# PgBouncer uses transaction mode, which is required for SET LOCAL RLS scoping.
# Fixed UUID for the dev tenant — all authenticated users are scoped to this tenant in development.
# Matches the tenant inserted by db:seed. Do not change unless you wipe and re-seed.
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001

DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:10409/platform
# Migrations must run as the superuser (CREATE SCHEMA requires it).
# Points directly to Postgres (port 10408), bypassing PgBouncer.
MIGRATION_DATABASE_URL=postgresql://migration_user:migration_user_dev_password@localhost:10408/platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ──────────────────────────────────────────────────────────────────────
# Inert for any host-side process — aw-backend/aw-worker override this to
# redis://redis:6379 (Docker service name) via docker-compose.yml. Redis has
# no host port mapping, so this value only needs to satisfy the config schema.
REDIS_URL=redis://localhost:6379
# Post-auth, per-tenant rate limit (req/min) enforced by requireAuth() (#195). Optional — defaults to 600.
# RATE_LIMIT_TENANT_PER_MIN=600

# APP_URL: the URL the frontend (admin-ui) is served from.
# Drives CORS_ORIGIN on the backend and API_URL in the browser bundle.
#   Local dev:   http://localhost:10406
#   Production:  https://openwind-nexus.rokkalabs.com
APP_URL=http://localhost:10406

# ── Auth (AuthNexus) ────────────────────────────────────────────────────────────
# External OIDC provider — RS256 JWT verification via JWKS only, no local
# identity-provider container and no introspection call.
AUTHNEXUS_ISSUER=https://auth.rokkalabs.com
AUTHNEXUS_JWKS_URL=https://auth.rokkalabs.com/api/v1/auth/jwks
AUTHNEXUS_AUDIENCE=your_authnexus_web_client_id

# Frontend (browser) OIDC client config — consumed by apps/admin-ui/vite.config.ts
# and injected into window.__CONFIG__ via /env.js.
AUTHNEXUS_AUTHORITY=https://auth.rokkalabs.com
AUTHNEXUS_CLIENT_ID=your_authnexus_web_client_id
# AUTHNEXUS_ORG_ID is also read server-side now (required alongside any M2M
# grant request — see AUTHNEXUS_ZITADEL_AUD below).
AUTHNEXUS_ORG_ID=your_authnexus_org_id
AUTHNEXUS_PROJECT_ID=your_authnexus_project_id

# M2M (service-account) grants only — the underlying Zitadel instance's own
# address, distinct from AUTHNEXUS_ISSUER above. Used two ways: (1) as the
# aud an M2M assertion must be signed with (the server that actually
# verifies the signature), or the /api/v1/auth/m2m endpoint rejects it with
# 401 "Invalid or unsigned service assertion"; (2) as the token endpoint base
# for the notification-outbound flow specifically, which POSTs directly to
# <this>/oauth/v2/token — Zitadel's native endpoint — instead of the
# /api/v1/auth/m2m wrapper, because ownovu's gateway only accepts tokens
# Zitadel issues directly (confirmed with AuthNexus + ownovu 2026-08-06).
# Ask your AuthNexus admin for this value — it changes if the underlying
# Zitadel instance is ever re-hosted.
AUTHNEXUS_ZITADEL_AUD=your_zitadel_instance_url

# No client_id or org_id params are sent for the notification-outbound M2M
# exchange — Zitadel's native /oauth/v2/token endpoint derives everything
# from the assertion's sub, and auto-populates the resulting token's
# client_id claim from the service account's own Zitadel username (confirmed
# by AuthNexus 2026-08-06). NOTE: ownovu's ALLOWED_CLIENT_IDS allowlist must
# separately include that exact username string, or the token is still
# rejected — this is tracked as an open item on ownovu's side, not something
# this app's config can work around.

# ── Notifications (Novu) ───────────────────────────────────────────────────────
NOVU_API_KEY=your_novu_api_key_here

# ── Outbound notification service (external, contract in docs/notification-outbound-contract.md) ──
# URL the worker POSTs { title, body, link, recipients, channels } to for email/sms/whatsapp delivery.
NOTIFICATION_SERVICE_URL=https://novu.notify.rokkalabs.com/notifications/deliver
# Service-account key for M2M auth to the outbound service (JWT Profile Grant / RFC 7523),
# same pattern as AUTHNEXUS_SERVICE_ACCOUNT_KEY above. NEVER commit the real value — set in .env.local.
NOTIFICATION_AUTHNEXUS_KEY_JSON=
NOTIFICATION_AUTHNEXUS_AUDIENCE=

# ── File storage (local disk — see docs/specs/local-disk-file-storage.md) ──────
# Host-side directory bind-mounted into aw-backend/aw-worker at /data/files.
# Defaults to a sibling directory next to the repo checkout (not inside it, so
# there's nothing to gitignore) — same value works unchanged on a laptop or a
# server; only override if you want files stored somewhere else on that host.
FILES_STORAGE_PATH_HOST=../openwind-authnexus-files

# ── S3 (still used by apps/worker/src/export-worker.ts for bulk exports —
#      file *attachments* moved to local disk above, exports did not) ─────────
S3_ENDPOINT=http://localhost:10410
S3_BUCKET=platform-files
S3_ACCESS_KEY=platform_access_key
S3_SECRET_KEY=platform_secret_key_dev_only

# ── Docker Compose overrides (optional) ───────────────────────────────────────
# Override host-port mappings when the defaults conflict with other services.
# These are consumed by docker-compose.yml via ${VAR:-default} syntax.
# Leave unset for standard local dev (uses the default ports shown).
#
# POSTGRES_HOST_PORT=10408    # host port for direct Postgres access (default: 10408)
# ADMIN_UI_HOST_PORT=10406    # host port for Vite dev server (default: 10406)
#
# ── Vite dev server (server deployments only) ──────────────────────────────────
# VITE_ALLOWED_HOSTS=openwind.yourcompany.com  # comma-separated; omit for local dev
# VITE_API_PROXY_TARGET=http://ow-backend:3000 # proxy /api to this URL; omit for local dev

# ── Auto-logout on inactivity (docs/specs/auto-logout-on-inactivity.md) ────────
# Config-driven so the timeout can be relaxed (or disabled) without editing
# source. Both are optional. If VITE_IDLE_LOGOUT_ENABLED is left unset, the
# hook auto-disables itself on Vite's dev server and on any localhost/127.0.0.1
# origin, and defaults to enabled (5 minutes) everywhere else — set it
# explicitly to override either default.
# VITE_IDLE_LOGOUT_ENABLED=false          # "false" disables it entirely; "true" force-enables (e.g. on localhost); unset = auto
# VITE_IDLE_LOGOUT_TIMEOUT_MINUTES=10     # whole minutes; unset/invalid falls back to 5

# ── AI (Anthropic) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Secrets (OpenBao) ──────────────────────────────────────────────────────────
# OpenBao UI: http://localhost:8200
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TRANSIT_KEY=platform-credentials

# Dev: use the static root token (set by docker-compose openbao service).
OPENBAO_TOKEN=dev-root-token

# Production (AppRole): comment out OPENBAO_TOKEN and set these instead.
# OPENBAO_ROLE_ID=
# OPENBAO_SECRET_ID=
